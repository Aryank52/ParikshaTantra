# ==============================================================================
# ParikshaTantra Environment Variables Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER ONLY (NEVER EXPOSE TO CLIENT BUNDLES)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
JWT_SECRET=YOUR_PRODUCTION_256BIT_JWT_SECRET
AES_MASTER_KEY=YOUR_64_CHAR_HEX_AES_MASTER_KEY
HMAC_ACTIVATION_KEY=YOUR_PRODUCTION_HMAC_ACTIVATION_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Supabase PostgreSQL Connection Pooler Strings
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Object Storage Credentials (Supabase Storage / AWS S3)
SUPABASE_URL="https://[REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
STORAGE_BUCKET="parikshatantra-vault"

# Redis Cache Credentials (Optional)
REDIS_URL="redis://default:[PASSWORD]@[HOST]:6379"
CORS_ALLOWED_ORIGINS="https://parikshatantra.vercel.app"

# ------------------------------------------------------------------------------
# CLIENT SAFE (VITE FRONTEND ENVIRONMENT VARIABLES)
# ------------------------------------------------------------------------------
VITE_API_URL="https://parikshatantra-backend.onrender.com"
VITE_WS_URL="wss://parikshatantra-backend.onrender.com"
